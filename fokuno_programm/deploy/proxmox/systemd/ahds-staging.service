[Unit]
Description=AhDs Staging Stack (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ahds/fokuno_programm/deploy/proxmox
ExecStart=/usr/bin/docker compose --env-file .env -f staging-compose.proxmox.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file .env -f staging-compose.proxmox.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
