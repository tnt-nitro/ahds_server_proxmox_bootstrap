[Unit]
Description=AhDs CT Update bei Browser-Anforderung
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ahds/fokuno_proxmox/deploy/proxmox
Environment=CTID=113
Environment=REPO_DIR=/opt/ahds
ExecStart=/bin/bash /opt/ahds/fokuno_proxmox/deploy/proxmox/native_update_ct_on_request.sh
